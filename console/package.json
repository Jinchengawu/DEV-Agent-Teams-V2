{
  "name": "agent-team-os-console",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "node --max-old-space-size=512 ./node_modules/typescript/bin/tsc --noEmit",
    "build": "node --max-old-space-size=512 ./node_modules/vite/bin/vite.js build",
    "test": "node --max-old-space-size=512 ./node_modules/vitest/vitest.mjs run --maxWorkers=1",
    "api:generate": "node ./node_modules/openapi-typescript/bin/cli.js ./openapi.json -o ./src/shared/api/generated/schema.ts",
    "api:check": "pnpm api:generate && git diff --exit-code -- openapi.json src/shared/api/generated/schema.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.85.5",
    "@xyflow/react": "^12.8.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.13.1"
}
