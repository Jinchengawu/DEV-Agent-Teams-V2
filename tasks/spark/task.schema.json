{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-team-os.local/schemas/spark-task-v1.json",
  "title": "Agent-Team-OS Spark Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "model", "architecture_revision", "base_revision", "kind", "allowed_paths", "forbidden_paths", "contracts", "acceptance", "verification"],
  "properties": {
    "id": {"type": "string", "pattern": "^SPARK-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "model": {"enum": ["gpt-5.3-codex-spark", "gpt-5.6-sol"]},
    "architecture_revision": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "kind": {"enum": ["frontend-component", "backend-crud", "test-expansion", "localization"]},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "forbidden_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "contracts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
